# Юнит system-демона swapnotif-rs (задача 8.1, design D9).
# Требования спеки daemon-lifecycle:
#   - Type=notify: готовность — sd_notify READY=1 после инициализации;
#   - Restart=on-failure: аварийный перезапуск (цикл ограничен StartLimit);
#   - изоляция ProtectSystem=strict + RestrictAddressFamilies=AF_UNIX AF_NETLINK
#     без потери функций: /proc доступен на чтение (ProtectSystem его не режет),
#     D-Bus-сокеты — AF_UNIX; демону нечего писать на диск, поэтому
#     ReadWritePaths не нужен.

[Unit]
Description=Мониторинг занятости swap с уведомлениями рабочего стола
# Только ordering-зависимость (без Wants/Requires): доставки нацелены на
# пользовательские шины /run/user/<uid>/bus, которые живут в графических
# сессиях; дождаться регистрации пользовательских сессий — разумный
# ordering-hint, но его отсутствие не должно блокировать старт
# (недоставленные события ретраятся, design D5/D6).
After=systemd-user-sessions.service

[Service]
Type=notify
ExecStart=/usr/bin/swapnotif-rs
Restart=on-failure
Environment=RUST_LOG=info
# Файловая система только на чтение, кроме /dev, /proc, /run: демону
# хватает чтения /proc и unix-сокетов (/run/user/*/bus, sd_notify).
ProtectSystem=strict
# D-Bus — только unix-сокеты; AF_NETLINK оставлен для служебных нужд
# библиотек; сетевых семейств нет.
RestrictAddressFamilies=AF_UNIX AF_NETLINK
# Дополнительный hardening: сужение радиуса при компрометации — запрет
# повышения привилегий, новых namespace/realtime, доступа к ядру, часам,
# cgroups, W^X на память и фильтр syscall'ов до @system-service.
# Функции не задеты: /proc читается как раньше, D-Bus и sd_notify —
# обычные AF_UNIX-сокеты, ожидание событий — sigtimedwait.
NoNewPrivileges=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
PrivateTmp=yes
SystemCallFilter=@system-service
# Требование спеки «Журналирование работы»: stdout/stderr → journald.
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
